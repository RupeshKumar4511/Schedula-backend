generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  clerkUserId  String   @unique
  email        String   @unique
  username     String?
  role         RoleEnum @default(patient)
}

enum RoleEnum {
  admin
  doctor
  patient
}